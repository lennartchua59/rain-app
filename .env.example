# Copy to .env.local for local dev (gitignored), and set the same variables in
# Netlify's site settings for production.

# Required: powers the in-app weather companion. Free key at
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional: any Groq model that supports tool use. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Optional: data.gov.sg rate-limits keyless callers; a free key avoids that.
# https://guide.data.gov.sg/developer-guide/api-overview/api-rate-limits
DATA_GOV_SG_API_KEY=
